# Modèle — à copier vers .signing/keystore.env (qui est gitignoré).
# Remplissez les valeurs réelles ; ne commitez JAMAIS ce fichier avec des secrets.
# Le build release lit ensuite ces variables (env prioritaire, puis ce fichier).
#
#   cp .signing/keystore.env.example .signing/keystore.env
#
PAPRA_KEY_ALIAS=papra
PAPRA_KEYSTORE=/chemin/absolu/vers/papra-share-release.jks
PAPRA_KEY_PASSWORD=<mot_de_passe_de_la_cle>
PAPRA_KEYSTORE_PASSWORD=<mot_de_passe_du_keystore>